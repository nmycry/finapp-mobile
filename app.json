{
  "expo": {
    "name": "FinApp",
    "slug": "finapp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080C10"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finapp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "O FinApp usa a câmera para escanear comprovantes e documentos.",
        "NSPhotoLibraryUsageDescription": "O FinApp acessa sua galeria para importar imagens de comprovantes.",
        "NSUserNotificationsUsageDescription": "Receba alertas de transações e vencimentos importantes."
      }
    },
    "android": {
      "package": "com.finapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080C10"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "finapp",
    "extra": {
      "eas": {
        "projectId": "finapp-mobile"
      }
    }
  }
}
